{
  "name": "medibridge",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @medibridge/shared build && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @medibridge/api db:generate",
    "db:migrate": "pnpm --filter @medibridge/api db:migrate",
    "db:deploy": "pnpm --filter @medibridge/api db:deploy",
    "db:seed": "pnpm --filter @medibridge/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
